apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: wp-$sitename
  namespace: wordpress
spec:
  ingressClassName: contour
  rules:
  - host: $sitename.wp.ocfhosted.com
    http:
      paths:
      - backend:
          service:
            name: wp-$sitename
            port:
              number: 80
        path: /
        pathType: Prefix
  tls:
  - hosts:
    - $sitename.wp.ocfhosted.com
    secretName: wp-$sitename-tls
